<section id="post-{{index}}" class="wrapper post bg-img" data-bg="{{post.image}}">
	<div class="inner">
		<article class="box">
			<header>
				{{#if @first}}<p class="first-post">Primer post</p>{{/if}}
				<h2>{{post.title}}</h2>
				<p>{{formatDate post.date}}</p>
			</header>
			<div class="content">
				<p>{{post.summary}}</p>
			</div>
			<footer>
				<a href="/posts/{{post.slug}}" class="button alt">Leer más</a>
			</footer>
		</article>
	</div>
	{{#unless @last}}
		<a href="#post-{{add index 1}}" class="more">Siguiente</a>
	{{/unless}}
</section>